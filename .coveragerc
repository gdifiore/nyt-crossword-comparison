[run]
source = .
omit =
    */tests/*
    */venv/*
    */.venv/*
    */client/*
    */node_modules/*
    config/jest/*
    scripts/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
